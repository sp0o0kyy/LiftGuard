# ==========================================================
# LiftGuard — Конфигурация для самостоятельного развёртывания
# Скопируйте этот файл в .env и заполните значения
# ==========================================================

# Сервер
PORT=3000
NODE_ENV=production

# База данных (MySQL / MariaDB). При ручном развёртывании на VPS
# хост базы — "db", а не "localhost"
DATABASE_URL=mysql://liftguard:REPLACE_DB_PASSWORD@127.0.0.1:3306/liftguard
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_DB_ROOT_PASSWORD

# Секрет для подписи сессий (минимум 32 случайных символа)
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# Данные для локальной проверки (не использовать в production)
# pnpm seed
